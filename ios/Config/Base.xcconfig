// Shared build settings for iPlanet Pay (SwiftUI).
// Values here are overridden by the target only when the pbxproj sets the same key.

PRODUCT_NAME = iPlanet Pay
PRODUCT_BUNDLE_IDENTIFIER = com.iplanetpay.app
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTED_PLATFORMS = iphoneos iphonesimulator

INFOPLIST_FILE = iPlanetPay/Info.plist
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_EXPAND_BUILD_SETTINGS = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = Accent

CODE_SIGN_STYLE = Automatic
CODE_SIGNING_REQUIRED = YES
CODE_SIGNING_ALLOWED = YES
CODE_SIGN_ENTITLEMENTS = iPlanetPay/iPlanetPay.entitlements
// Simulator signs locally with an empty Team. A physical device still needs a Team in Xcode.
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_EMIT_LOC_STRINGS = NO
DEVELOPMENT_ASSET_PATHS =

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_MODULE_VERIFIER = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO
