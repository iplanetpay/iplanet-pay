// Copie para Secrets.xcconfig. A chave publishable é pública (cliente).
// Não coloque service role, o secret do Google nem o client ID Web em GOOGLE_IOS_CLIENT_ID.
// Enquanto os IDs do Google forem placeholder, o app usa o OAuth no navegador.
// O truque https:/$()/ evita que o xcconfig trate "//" como comentário.

SUPABASE_URL = https:/$()/xeeogfmmasvgbpmodqym.supabase.co
SUPABASE_ANON_KEY = sb_publishable_sua_chave_publica
WEB_APP_URL = https:/$()/iplanet-pay.vercel.app
GOOGLE_IOS_CLIENT_ID = placeholder.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder
