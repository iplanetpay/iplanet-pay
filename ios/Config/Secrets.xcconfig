// Projeto live usado por https://iplanet-pay.vercel.app.
// Chave publishable pública (sb_publishable_…), a mesma do bundle web. Não é service role.
// O truque https:/$()/ evita que o xcconfig trate "//" como comentário.
//
// Google nativo: troque os dois placeholders pelo client ID *iOS* do Google Cloud.
// Não cole aqui o client ID Web do dashboard (940958699246-l1ie964lhrri5ejnot899nu2uldat5n3).
// O reverso de 123-abc.apps.googleusercontent.com é com.googleusercontent.apps.123-abc.
// Enquanto forem placeholder, o app entra com Google pelo fluxo OAuth (ASWebAuthenticationSession).

SUPABASE_URL = https:/$()/xeeogfmmasvgbpmodqym.supabase.co
SUPABASE_ANON_KEY = sb_publishable_LfK2s9fW5x1JDOQZ05khBg_BjT2wDhq
WEB_APP_URL = https:/$()/iplanet-pay.vercel.app
GOOGLE_IOS_CLIENT_ID = placeholder.apps.googleusercontent.com
GOOGLE_IOS_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder
