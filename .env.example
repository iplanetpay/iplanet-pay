# Supabase (quando preenchido, auth real é usado)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (links de indicação, e-mails, logo absoluta)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Pix / Mercado Pago (nunca inventar / commitar valores reais)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# E-mail transacional (Resend) — vazio = email_outbox stub
# RESEND_API_KEY=
EMAIL_FROM=noreply@iplanet.com.br

# Cron: lembrete aporte + auto-cancel reservas zeradas 30d
# CRON_SECRET=
# GET/POST /api/cron/aporte-reminder
# GET/POST /api/cron/stale-reservations

# Agente AI via WhatsApp com o admin (stubs — conectar quando produto 100%)
# AGENT_API_KEY=
# (Telegram removido — use WhatsApp)

# Sem credenciais, o app entra em modo demo automaticamente.
# Force explicitamente:
USE_MOCK_AUTH=true

# WhatsApp via WAHA — vazio = só fila whatsapp_dispatch_queue
# WAHA Core só aceita a sessão default
# WAHA_API_URL=https://waha.exemplo.com
# WAHA_API_KEY=
# WAHA_SESSION=default

# Cron WhatsApp metas: /api/cron/whatsapp-goals (Bearer CRON_SECRET)

# Google OAuth (não coloque Client Secret no Next.js)
# Ative em Supabase Dashboard → Authentication → Providers → Google
# Redirect Supabase: https://zjnikfrledckmjahwnsb.supabase.co/auth/v1/callback
# Redirect app (URL Configuration): http://127.0.0.1:3000/auth/callback
# (+ produção quando conhecida)

# Senha de confirmação admin para aprovar/rejeitar saques (default 1234)
# WITHDRAWAL_APPROVE_PASSWORD=1234

# E-mail de notificação admin (saques aprovados); fallback admin@iplanet.com.br
# ADMIN_NOTIFY_EMAIL=admin@iplanet.com.br
